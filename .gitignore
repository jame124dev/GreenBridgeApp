# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# EAS / signing — DO NOT COMMIT
# credentials.json holds iOS provisioning + Android keystore refs
credentials.json
*.keystore

# Firebase / Google services — contain API keys
google-services.json
GoogleService-Info.plist

# Sentry CLI auth token
.sentryclirc

# Editor / IDE
# Keep shared VS Code defaults (extensions + on-save settings) tracked,
# ignore everyone's personal launch/tasks/etc.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.cursor/
.zed/
*.swp
*.swo
*~

# Windows
Thumbs.db
Desktop.ini
ehthumbs.db

# Test coverage
/coverage
*.lcov
.nyc_output/

# npm pack artefacts
*.tgz

# generic temp / logs
*.log
tmp/
.tmp/
temp/

# `eas metadata:pull` downloads ASC screenshots here — duplicates assets/store/ios
store/

# Local Android release signing (keystore + passwords) — NEVER commit
credentials/
