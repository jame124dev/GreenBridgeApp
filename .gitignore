# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
# ⚠️ `.env` and `.env*.local` do NOT match a backup like
# `.env.bak-localhost-1790056062`, which is how one turned up untracked — and
# therefore stageable — while holding a real key. Anything that starts `.env`
# is a secret until proven otherwise.
.env.*

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# EAS / signing — DO NOT COMMIT
# credentials.json holds iOS provisioning + Android keystore refs
credentials.json
*.keystore

# Firebase / Google services — contain API keys
google-services.json
GoogleService-Info.plist

# Sentry CLI auth token
.sentryclirc

# Editor / IDE
# Keep shared VS Code defaults (extensions + on-save settings) tracked,
# ignore everyone's personal launch/tasks/etc.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.cursor/
.zed/
*.swp
*.swo
*~

# Windows
Thumbs.db
Desktop.ini
ehthumbs.db

# Test coverage
/coverage
*.lcov
.nyc_output/

# npm pack artefacts
*.tgz

# generic temp / logs
*.log
tmp/
.tmp/
temp/

# `eas metadata:pull` downloads ASC screenshots here — duplicates assets/store/ios
store/

# Local Android release signing (keystore + passwords) — NEVER commit
credentials/

# Device-verification scratch, not code.
# `adb shell uiautomator dump` writes a hierarchy XML per screen measured; these
# accumulate at the repo root with whatever name the session gave them (C1, D4,
# ac…) and are meaningless a day later. `app_debug/` is ~11 MB of screenshots
# from the same passes — the workspace CLAUDE.md already lists it as
# non-canonical.
/*.xml
app_debug/

# Cloned UI reference repos — read and copy from, never bundled or committed.
# See ui_git_repo/README.md. Excluded from tsconfig and metro.config.js too.
ui_git_repo/
scripts/out/
