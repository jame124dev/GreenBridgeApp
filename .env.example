# Copy from 101lab-2/.env: VITE_X_SYSTEM_KEY → X_SYSTEM_KEY (required for login)
GREENBIDZ_API_URL=https://api-staging.greenbidz.com/api/v1
QUIPPY_API_URL=https://quippy-staging.example.com
X_SYSTEM_KEY=your_key_from_101lab2_env
# Must match casing the backend expects — web uses "LabGreenbidz"
SITE_TYPE=LabGreenbidz
# Seller dashboard base (no /api/v1) — e.g. https://lab.101recycle.com
WEB_APP_URL=https://localhost:5173
SENTRY_DSN=

# ── Feature flags (EXPO_PUBLIC_* are inlined at bundle time) ──────────────────
# Smart-detection scan flow. On by default; set to 0 for the legacy flow.
EXPO_PUBLIC_SMART_DETECT=1
# v2 SSE smart-detection (opt-in; default off). react-native-sse is pure JS
# (XHR-based), so a Metro restart picks it up — no dev-client rebuild needed
# for this flag. EXPO_PUBLIC_* is inlined at bundle time, so restart Metro
# after changing it. See Docs/SMART_DETECT_V2_SSE_INTEGRATION_PLAN.md.
EXPO_PUBLIC_SMART_DETECT_V2=0
# User-type build fork. Values: 'seller' | 'customer'. Default seller (any
# value other than 'customer' falls back to seller). Selects which app the
# bundle loads at build time; restart Metro after changing it.
EXPO_PUBLIC_USER_TYPE=seller
# OneSignal push (shared with the web app; app id is public by design). Empty =>
# push disabled. Changing it requires a dev-client REBUILD (native module).
EXPO_PUBLIC_ONESIGNAL_APP_ID=
# Save-as-draft + resumable "Your drafts" list for the AI-scan flow (seller +
# customer lab). Opt-in, default off. Pure-JS — a Metro restart applies it, no
# dev-client rebuild. Enable this FIRST in staged rollout, verify on-device.
EXPO_PUBLIC_DRAFTS=0
# Continue-in-background AI recognition (seller scan): start a recognition job,
# leave, and the finished draft surfaces in the drafts list (+ push deep-link).
# Opt-in, default off. Requires EXPO_PUBLIC_DRAFTS=1 for the finished job to land
# in the drafts list. Enable AFTER drafts is verified. Metro restart to apply.
# PRE-FLIP FOLLOW-UPS — both RESOLVED + verified on-device against prod (2026-07-22):
#  1. [DONE] Full transport-swap: the on-screen v2 scan now runs AS a foreground
#     recognition job (upload once -> createRecognitionJob{foreground:true} ->
#     tail). "Continue in background" detaches that SAME job — no duplicate
#     upload/recognition, and a foreground job the seller watches to completion
#     does NOT persist a spurious draft/bell (backend defers until detach).
#     Needs backend commit cc7fba3 (foreground + POST /recognition-jobs/:id/detach).
#  2. [DONE] pending-ai resume mapping: `mapPendingAiDraft` opens a finished
#     background draft from "Your drafts" into the editable scan form (mobile 45b7ba1).
# Both blockers cleared. Flipping this ON for real users is now a product/QA call
# (still gated behind a prod app build); safe with the flag OFF (default).
EXPO_PUBLIC_BACKGROUND_RECOGNITION=0

# --- Experiment: virtualized streaming chat list (opt-in, default OFF) ---
# Swaps the lab AI chat's hand-built pin-to-top ScrollView for
# react-native-streaming-message-list (Legend List) to A/B its scroll behavior
# against ours. OFF = the exact current ScrollView (behavior-neutral). Set to 1
# + restart Metro to trial the library on the AI chat.
EXPO_PUBLIC_STREAMING_LIST=0
