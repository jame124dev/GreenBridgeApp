# Copy from 101lab-2/.env: VITE_X_SYSTEM_KEY → X_SYSTEM_KEY (required for login)
GREENBIDZ_API_URL=https://api-staging.greenbidz.com/api/v1
QUIPPY_API_URL=https://quippy-staging.example.com
X_SYSTEM_KEY=your_key_from_101lab2_env
# Must match casing the backend expects — web uses "LabGreenbidz"
SITE_TYPE=LabGreenbidz
# Seller dashboard base (no /api/v1) — e.g. https://lab.101recycle.com
WEB_APP_URL=https://localhost:5173
SENTRY_DSN=
